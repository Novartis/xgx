# rmarkdown::render_site() staging directory
Rmarkdown/www/

# Generated site output at the repository root. Removed on 2026-08-11 when the
# site moved to being built by CI; the live site is now whatever
# .github/workflows/build-site.yml publishes, never what is committed here.
#
# The scripts that used to create these (Rmarkdown/000_render_site.R and its two
# variants) were retired the same day, so nothing in the repository writes here
# any more. Kept as a backstop: an old checkout still has those scripts, and
# running one silently recreates ~292 files ready to be committed.
/*.html
/*_files/
/site_libs/
/SiteResources/

# IDA summary exports written by Rmarkdown/Data_Checking.Rmd. The *_full.json
# deliberately contains USUBJIDs -- the document says to keep it local -- so it
# must not be committed, and neither should land in the repository root.
*_summary_full.json
*_summary_no_subjids.json

# RxODE compilation artifacts, generated by Rmarkdown/PKPD_Datasets.Rmd
Data.cpp
Rmarkdown/Data.cpp
Rmarkdown/Makevars
Rmarkdown/mod1.d/
